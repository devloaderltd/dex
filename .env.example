# ===== Network =====
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
SEPOLIA_PRIVATE_KEY="0xYOUR_PRIVATE_KEY"   # wallet that owns IdentityRegistry + PuriCoin on Sepolia

# Optional (verify)
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_KEY"

# Optional (oracle router)
# Sepolia ETH/USD Chainlink feed (set if you want live pricing)
ETH_USD_FEED="0x0000000000000000000000000000000000000000"

# Optional (KYC)
# Address that signs KYC approvals (backend signer). Defaults to deployer if omitted.
KYC_SIGNER_ADDRESS="0x0000000000000000000000000000000000000000"

# Optional (staking)
REWARDS_DURATION_SECONDS="604800"  # 7 days
